# Copy to backend/.env
# The server reads DATA for Postgres (main.rs). If your host only sets DATABASE_URL, set DATA to the same value.
DATA=postgres://user:password@localhost:5432/clawpify
PORT=3000

CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

APP_PUBLIC_ORIGIN=http://127.0.0.1:3001

CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

RUST_API_URL=http://127.0.0.1:3000

DATABASE_URL=postgres://user:password@localhost:5432/clawpify

OPENAI_API_KEY=

# S3: try_client_from_env uses RAILWAY_BUCKET_NAME; set BUCKET too if your platform only provides that name.
BUCKET=

ENDPOINT=

RAILWAY_BUCKET_ID=

RAILWAY_BUCKET_NAME=

REDIS_URL=

REGION=

WAITLIST_IP_PEPPER=

EBAY_USE_SANDBOX=1

EBAY_CLIENT_ID=

EBAY_DEV_ID=

EBAY_CLIENT_SECRET=

EBAY_OAUTH_SCOPES=https://api.ebay.com/oauth/api_scope/sell.inventory.readonly

EBAY_OAUTH_REDIRECT_URI=https://your-public-api-host/api/v1/oauth/ebay/callback


OPENAPI_SERVER_URL=http://127.0.0.1:3000/api/v1


SECRET_ACCESS_KEY=

OAUTH_STATE_SECRET=
