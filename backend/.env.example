# Copy to backend/.env

DATABASE_URL=postgres://user:password@localhost:5432/clawpify
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# SPA URL for OAuth return redirects (frontend, not the API host). Optional if loopback is in CORS.
# APP_PUBLIC_ORIGIN=http://127.0.0.1:3001

# Optional: absolute base for OpenAPI "Try it" (default is same-origin /api/v1)
# OPENAPI_SERVER_URL=https://api.example.com/api/v1

# Direct browser → Rust (Authorization: Bearer): JWKS URL from your Clerk instance
# (Dashboard → API keys — same subdomain as your Frontend API / publishable key).
# CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
#
# Optional: lock verification to JWT `iss` (not shown as its own field in Clerk UI; you can read `iss` from any decoded session token). Safe to omit.
# CLERK_JWT_ISSUER=https://<your-instance>.clerk.accounts.dev

# --- eBay (backend routes /api/v1/oauth/ebay/*) ---
# RuName redirect_uri must match EBAY_OAUTH_REDIRECT_URI exactly.
# Without EBAY_* + OAUTH_STATE_SECRET + CHANNEL_ENCRYPTION_KEY, eBay OAuth stays disabled.
# EBAY_USE_SANDBOX=1
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_OAUTH_REDIRECT_URI=https://<public-api-host>/api/v1/oauth/ebay/callback
# EBAY_OAUTH_SCOPES=https://api.ebay.com/oauth/api_scope/sell.inventory.readonly
# EBAY_OAUTH_SUCCESS_REDIRECT=https://<public-api-host>/api/v1/go/oauth/ebay/success
# OAUTH_STATE_SECRET=long_random_min_16_chars
# CHANNEL_ENCRYPTION_KEY=64_hex_chars_or_base64_32_bytes

# S3-compatible uploads: ENDPOINT, REGION, RAILWAY_BUCKET_NAME, RAILWAY_BUCKET_ID (access key), SECRET_ACCESS_KEY, optional BUCKET_FORCE_PATH_STYLE=1
# Other: Shopify, OpenAI, Twilio, waitlist — search backend/src for std::env::var calls
