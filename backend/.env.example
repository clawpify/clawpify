# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/clawpify

# Waitlist / POST /api/*/waitlist — HMAC pepper for hashing client IPs (required in release builds)
# WAITLIST_IP_PEPPER=long_random_secret_do_not_commit

# Max new waitlist signups per hashed IP per rolling 24h (default 5)
# WAITLIST_MAX_SIGNUPS_PER_IP_PER_DAY=5

# When Rust is hit directly behind a proxy (not via Bun), set to 1 to trust X-Forwarded-For first hop
# TRUST_FORWARDED_FOR=1

# S3-compatible storage (e.g. Railway). Set ENDPOINT, REGION, BUCKET, RAILWAY_BUCKET_ID (access key id), BUCKET_SECRET or uploads return 503.
# ENDPOINT=
# REGION=
# BUCKET=
# RAILWAY_BUCKET_ID=
# BUCKET_SECRET=
# BUCKET_FORCE_PATH_STYLE=1

# Optional: Restrict scraping to these hosts (pipe-separated). When unset, all URLs allowed.
# Example for Shopify: myshopify.com|shopify.com
# TRUSTED_HOSTS=myshopify.com|shopify.com

# CORS: origins allowed to call this API (comma-separated)
# Production: set to your app domain, e.g. https://app.clawpify.com
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# SPA URL for browser redirects (Bun dev server), NOT the ngrok/API host — e.g. http://127.0.0.1:3001
# If unset, eBay bare-callback redirect picks localhost/127.0.0.1 from CORS_ALLOWED_ORIGINS before other entries.
# eBay RuName: auth accepted → https://<api-host>/api/v1/oauth/ebay/callback
# eBay RuName: auth declined → https://<api-host>/api/v1/go/oauth/ebay/declined (302 to /app?ebay_oauth=declined)
# After successful token save, prefer EBAY_OAUTH_SUCCESS_REDIRECT=https://<api-host>/api/v1/go/oauth/ebay/success (302 to /app?ebay_oauth=connected), or use /api/v1/go/app for no query flag.
# APP_PUBLIC_ORIGIN=http://127.0.0.1:3001
# EBAY_OAUTH_SUCCESS_REDIRECT=https://your-api-host/api/v1/go/oauth/ebay/success
#
# eBay user OAuth (all required for /oauth/ebay/*); RuName redirect_uri must match EBAY_OAUTH_REDIRECT_URI exactly.
# EBAY_USE_SANDBOX=1
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_OAUTH_REDIRECT_URI=
# Required: space-separated scope URIs (EBAY_OAUTH_SCOPES preferred; EBAY_OAUTH_SCOPE also accepted).
# EBAY_OAUTH_SCOPES=https://api.ebay.com/oauth/api_scope/sell.inventory.readonly
# EBAY_DEV_ID is shown in the eBay developer UI but is NOT read by Clawpify OAuth — omit it unless you use it elsewhere.
# OAUTH_STATE_SECRET=
# CHANNEL_ENCRYPTION_KEY=

# LLM: required for POST /api/llm/agents
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-5.2

# Shopify OAuth — use the same redirect URL in Partner Dashboard and here.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_OAUTH_REDIRECT_URL=https://example.com/api/reseller/oauth/shopify/callback
# OAUTH_STATE_SECRET=long_random_string_min_16_chars
# CHANNEL_ENCRYPTION_KEY=32 bytes as 64 hex chars OR base64 (openssl rand -hex 32 | openssl rand -base64 32)
