# Clerk — https://dashboard.clerk.com
BUN_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Browser calls this origin for /api/*; Bun proxies to Rust. Match PORT (default 3001).
# Do not set to *.clerk.accounts.dev — that is Clerk’s Frontend API, not Clawpify’s REST API.
BUN_PUBLIC_API_URL=http://localhost:3001
BUN_PUBLIC_BASE_URL=https://clawpify.com
RUST_API_URL=http://127.0.0.1:3000
CLERK_SECRET_KEY=sk_test_...

# Optional: BUN_PUBLIC_API_BASE, BUN_PUBLIC_RUST_API_URL, PORT, RUST_PROXY_TIMEOUT_MS, CLAWPIFY_PROD=1
