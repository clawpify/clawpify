# Clerk (create app at https://dashboard.clerk.com)
# Sign-in only: also set Clerk Dashboard → Configure → Restrictions → Sign-up mode (e.g. Restricted).
CLERK_SECRET_KEY=sk_test_...
BUN_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Bun → Rust proxy. Injected into the HTML shell as `window.__CLAWPIFY_PUBLIC_API_BASE__` (use BUN_PUBLIC_RUST_API_URL to override for the browser only). Empty = same-origin /api via Bun.
# Browser → Rust directly needs CLERK_JWKS_URL on the backend (see backend/.env.example).
RUST_API_URL=http://127.0.0.1:3000
PORT=3001

# Railway: RUST_API_URL = Rust service URL, not this Bun app’s public URL. Health probe: GET /healthz (not /api/health).
# BUN_SERVICE_URL=
#
# Upstream fetch timeout in ms (default 25000).
# RUST_PROXY_TIMEOUT_MS=25000

# Optional: public origin for waitlist when `RUST_API_URL` is not browser-reachable (e.g. *.railway.internal). Overrides `RUST_API_URL` for the client only.
# BUN_PUBLIC_API_BASE=https://your-public-api.example.com

# Optional: Firecrawl for website scraping (falls back to HTTP if unset)
# FIRECRAWL_API_KEY=fc-...

CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
