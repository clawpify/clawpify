{
  "name": "clawpify",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "bun --hot --watch src/index.ts",
    "lint": "tsc --noEmit",
    "test": "bun run lint && bun run build",
    "test:frontend": "bun run test",
    "test:backend": "cd backend && cargo test",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*' --env='VITE_*'",
    "start": "CLAWPIFY_PROD=1 bun src/index.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.0.1",
    "@clerk/react": "6.0.1",
    "dompurify": "^3.3.3",
    "marked": "^17.0.5",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.13.1",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3"
  }
}
